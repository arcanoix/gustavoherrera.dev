---
import ProjectSection from "@/components/ProjectSection"
import PostsSection from "@/components/PostsSection"
import Timeline from "@/components/Timeline"
import Avatar from "@/components/Avatar"
import SkillsSection from "@/components/SkillsSection"
import { HiOutlineArrowDownCircle as DownIcon } from "react-icons/hi2"
import { FaGithub, FaLinkedin, FaDev, FaWhatsapp } from "react-icons/fa"
import { FaXTwitter } from "react-icons/fa6"
import { useTranslations } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<main class="p-4 text-slate-700 dark:text-slate-400">
  <!-- Hero -->
  <section
    class="flex flex-col w-full h-screen justify-center items-center gap-6"
  >
    <div class="flex flex-col items-center gap-3 text-center max-w-2xl">
      <span
        class="text-xs font-semibold tracking-widest uppercase text-slate-500 dark:text-slate-400"
      >
        {t("hero.role")}
      </span>
      <h1
        class="text-4xl md:text-6xl font-bold text-slate-800 dark:text-slate-100"
      >
        Gustavo Herrera
      </h1>
      <p
        class="text-base md:text-lg text-slate-500 dark:text-slate-400 max-w-xl"
      >
        {t("hero.description")}
      </p>
      <p class="text-sm text-slate-400 dark:text-slate-500">
        {t("hero.location")}
      </p>
    </div>

    <div
      class="flex gap-6 md:gap-10 mt-2 border border-slate-200 dark:border-slate-700 rounded-2xl px-6 md:px-10 py-4"
    >
      <div class="text-center">
        <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">
          15+
        </p>
        <p class="text-xs text-slate-500">{t("stats.years")}</p>
      </div>
      <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">
          333+
        </p>
        <p class="text-xs text-slate-500">{t("stats.repos")}</p>
      </div>
      <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">
          5.0
        </p>
        <p class="text-xs text-slate-500">{t("stats.rating")}</p>
      </div>
      <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">
          28
        </p>
        <p class="text-xs text-slate-500">{t("stats.reviews")}</p>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 justify-center mt-2">
      <a
        href="https://www.freelancer.com/u/gustavoherrera84"
        target="_blank"
        rel="noreferrer"
        class="px-5 py-2 rounded-full bg-slate-800 dark:bg-slate-200 text-slate-100 dark:text-slate-800 text-sm font-medium hover:opacity-90 transition-opacity"
      >
        {t("hero.hireMe")}
      </a>
      <a
        href="#projects"
        class="px-5 py-2 rounded-full border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        {t("hero.viewProjects")}
      </a>
    </div>

    <DownIcon className="text-2xl animate-bounce mt-2" />
  </section>

  <!-- Projects -->
  <section
    id="projects"
    class="flex flex-col w-full justify-center items-center gap-28"
  >
    <h2 class="font-bold">{t("section.projects")}</h2>
    <ProjectSection lang={lang} client:load />
  </section>

  <!-- Skills -->
  <section
    id="skills"
    class="flex flex-col w-full justify-center items-center gap-16 mt-56"
  >
    <h2 class="font-bold">{t("section.skills")}</h2>
    <SkillsSection lang={lang} />
  </section>

  <!-- Experience -->
  <section
    id="experience"
    class="flex flex-col w-full justify-center items-center gap-28 mt-56"
  >
    <h2 class="font-bold">{t("section.experience")}</h2>
    <Timeline lang={lang} />
  </section>

  <!-- Posts -->
  <section
    id="posts"
    class="flex flex-col w-full justify-center items-center gap-28 mt-56"
  >
    <h2 class="font-bold">{t("section.posts")}</h2>
    <PostsSection lang={lang} client:load />
  </section>

  <!-- About -->
  <section
    id="about"
    class="flex flex-col w-full justify-center items-center gap-16 mt-56"
  >
    <h2 class="font-bold">{t("section.about")}</h2>
    <div class="flex flex-col md:flex-row items-center gap-10 max-w-[700px]">
      <Avatar
        src="https://avatars.githubusercontent.com/u/6331999?v=4"
        alt="Gustavo Herrera"
        client:load
      />
      <div class="flex flex-col gap-4 text-center md:text-left">
        <p>
          {t("about.p1Start")}
          <strong>Gustavo Herrera</strong>{t("about.p1End")}
        </p>
        <p>
          {t("about.p2")}
        </p>
        <p>
          {t("about.p3")}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section
    id="contact"
    class="flex flex-col w-full justify-center items-center gap-12 mt-56"
  >
    <h2 class="font-bold">{t("section.contact")}</h2>
    <div class="flex flex-col items-center gap-6 max-w-[500px] text-center">
      <p>
        {t("contact.description")}
      </p>
      <a
        href="mailto:gustavoh.2312@gmail.com"
        class="text-lg font-medium text-slate-800 dark:text-slate-200 hover:underline"
      >
        gustavoh.2312@gmail.com
      </a>
      <div class="flex gap-6 text-2xl text-slate-700 dark:text-slate-300">
        <a
          href="https://github.com/arcanoix"
          target="_blank"
          rel="noreferrer"
          class="hover:scale-110 transition-transform"
        >
          <FaGithub />
        </a>
        <a
          href="https://www.linkedin.com/in/thavoo/"
          target="_blank"
          rel="noreferrer"
          class="hover:scale-110 transition-transform"
        >
          <FaLinkedin />
        </a>
        <a
          href="https://dev.to/arcanoix"
          target="_blank"
          rel="noreferrer"
          class="hover:scale-110 transition-transform"
        >
          <FaDev />
        </a>
        <a
          href="https://x.com/arcanoix_"
          target="_blank"
          rel="noreferrer"
          class="hover:scale-110 transition-transform"
        >
          <FaXTwitter />
        </a>
        <a
          href="https://wa.me/+584121367894"
          target="_blank"
          rel="noreferrer"
          class="hover:scale-110 transition-transform"
        >
          <FaWhatsapp />
        </a>
      </div>
      <a
        href="https://www.freelancer.com/u/gustavoherrera84"
        target="_blank"
        rel="noreferrer"
        class="text-sm text-slate-500 dark:text-slate-400 hover:underline"
      >
        freelancer.com/u/gustavoherrera84
      </a>
    </div>
  </section>
</main>
<footer>
  <p class="text-center text-sm text-slate-700 dark:text-slate-400 p-4 mt-28">
    {t("footer.made")} &#x2665; by Gustavo Herrera | @arcanoix
  </p>
</footer>
