---
import ProjectSection from "@/components/ProjectSection"
import PostsSection from "@/components/PostsSection"
import Timeline from "@/components/Timeline"
import Avatar from "@/components/Avatar"
import SkillsSection from "@/components/SkillsSection"
import HeroCorePanel from "@/components/HeroCorePanel"
import RoleTypewriter from "@/components/RoleTypewriter"
import { FaGithub, FaLinkedin, FaDev, FaWhatsapp } from "react-icons/fa"
import { FaXTwitter } from "react-icons/fa6"
import { useTranslations } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<main class="text-slate-800 dark:text-slate-200">
  <!-- Hero -->
  <section class="relative">
    <div
      class="mx-auto flex min-h-[min(820px,100svh)] max-w-6xl flex-col justify-center px-4 pb-14 pt-28 sm:px-6 md:pb-16 md:pt-32"
    >
      <div
        class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-14"
      >
        <div class="flex flex-col gap-6 lg:col-span-6">
          <p
            class="flex items-center gap-2.5 text-sm font-medium text-slate-500 dark:text-slate-400"
          >
            <span
              aria-hidden="true"
              class="h-1.5 w-1.5 rounded-full bg-violet-500 shadow-[0_0_12px_rgba(139,92,246,0.6)]"
            ></span>
            {t("hero.location")}
          </p>
          <h1
            class="text-[clamp(2.25rem,4.6vw,4rem)] font-semibold leading-[0.92] tracking-[-0.04em] text-slate-900 dark:text-white"
          >
            <span class="block overflow-hidden pb-1">
              <span class="reveal-line block">Gustavo Herrera</span>
            </span>
            <span class="hero-accent block overflow-hidden pb-2">
              <span class="reveal-line-delay block min-h-[1.05em]">
                <RoleTypewriter client:load />
              </span>
            </span>
          </h1>
          <p
            class="max-w-xl text-base leading-relaxed text-slate-600 dark:text-slate-300 md:text-lg"
          >
            {t("hero.description")}
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="https://www.freelancer.com/u/gustavoherrera84"
              target="_blank"
              rel="noreferrer"
              class="primary-action inline-flex min-h-12 items-center rounded-xl px-6 py-3 text-sm font-semibold"
            >
              {t("hero.hireMe")}
            </a>
            <a
              href="#projects"
              class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-slate-300 px-6 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-100 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5"
            >
              <span>&#9654;</span>
              <span>{t("hero.viewProjects")}</span>
            </a>
          </div>
          <dl
            class="grid grid-cols-2 gap-x-6 gap-y-4 border-t border-violet-500/15 pt-6 sm:grid-cols-4 sm:gap-8"
          >
            <div>
              <dt
                class="text-xs font-medium text-slate-500 dark:text-slate-400"
              >
                {t("stats.years")}
              </dt>
              <dd
                class="mt-1 text-xl font-semibold tabular-nums text-slate-900 dark:text-white md:text-2xl"
              >
                15+
              </dd>
            </div>
            <div>
              <dt
                class="text-xs font-medium text-slate-500 dark:text-slate-400"
              >
                {t("stats.repos")}
              </dt>
              <dd
                class="mt-1 text-xl font-semibold tabular-nums text-slate-900 dark:text-white md:text-2xl"
              >
                333+
              </dd>
            </div>
            <div>
              <dt
                class="text-xs font-medium text-slate-500 dark:text-slate-400"
              >
                {t("stats.rating")}
              </dt>
              <dd
                class="mt-1 text-xl font-semibold tabular-nums text-slate-900 dark:text-white md:text-2xl"
              >
                5.0
              </dd>
            </div>
            <div>
              <dt
                class="text-xs font-medium text-slate-500 dark:text-slate-400"
              >
                {t("stats.reviews")}
              </dt>
              <dd
                class="mt-1 text-xl font-semibold tabular-nums text-slate-900 dark:text-white md:text-2xl"
              >
                28
              </dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-6">
          <HeroCorePanel lang={lang} client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <h2
      class="section-heading mb-10 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
    >
      {t("section.projects")}
    </h2>
    <ProjectSection lang={lang} client:load />
  </section>

  <!-- Skills -->
  <section id="skills" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <h2
      class="section-heading mb-10 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
    >
      {t("section.skills")}
    </h2>
    <SkillsSection lang={lang} client:load />
  </section>

  <!-- Experience -->
  <section
    id="experience"
    class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28"
  >
    <h2
      class="section-heading mb-10 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
    >
      {t("section.experience")}
    </h2>
    <Timeline lang={lang} />
  </section>

  <!-- Posts -->
  <section id="posts" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <h2
      class="section-heading mb-10 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
    >
      {t("section.posts")}
    </h2>
    <PostsSection lang={lang} />
  </section>

  <!-- About -->
  <section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <h2
      class="section-heading mb-10 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
    >
      {t("section.about")}
    </h2>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-6 md:col-span-4">
        <Avatar
          src="https://avatars.githubusercontent.com/u/6331999?v=4"
          alt="Gustavo Herrera"
          client:load
        />
        <dl class="flex flex-col gap-4 pt-2">
          <div>
            <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">
              {t("about.locationLabel")}
            </dt>
            <dd class="text-sm font-medium text-slate-900 dark:text-white">
              {t("hero.location")}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">
              {t("about.focusLabel")}
            </dt>
            <dd class="text-sm font-medium text-slate-900 dark:text-white">
              {t("about.focusValue")}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">
              {t("about.sinceLabel")}
            </dt>
            <dd class="text-sm font-medium text-slate-900 dark:text-white">
              2005
            </dd>
          </div>
        </dl>
      </div>

      <div
        class="flex flex-col gap-5 text-lg leading-relaxed text-slate-700 dark:text-slate-300 md:col-span-8 md:text-xl"
      >
        <p>
          {t("about.p1Start")}
          <strong class="font-semibold text-slate-900 dark:text-white"
            >Gustavo Herrera</strong
          >{t("about.p1End")}
        </p>
        <p>{t("about.p2")}</p>
        <p>{t("about.p3")}</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-surface">
    <div
      class="mx-auto flex max-w-6xl flex-col justify-between gap-12 px-4 py-20 sm:px-6 md:py-28"
    >
      <div class="flex flex-col gap-4">
        <h2
          class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-4xl"
        >
          {t("section.contact")}
        </h2>
        <p class="max-w-xl text-lg text-slate-600 dark:text-slate-300">
          {t("contact.description")}
        </p>
      </div>

      <a
        href="mailto:gustavoh.2312@gmail.com"
        class="w-fit break-all text-2xl font-semibold tracking-tight text-slate-900 transition-colors hover:text-violet-600 dark:text-white dark:hover:text-violet-400 sm:text-4xl md:text-6xl"
      >
        gustavoh.2312@gmail.com
      </a>

      <div
        class="flex flex-col justify-between gap-6 pt-8 sm:flex-row sm:items-center"
      >
        <div
          class="flex items-center gap-5 text-xl text-slate-600 dark:text-slate-400"
        >
          <a
            href="https://github.com/arcanoix"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            class="transition-colors hover:text-slate-900 dark:hover:text-white"
          >
            <FaGithub />
          </a>
          <a
            href="https://www.linkedin.com/in/thavoo/"
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
            class="transition-colors hover:text-slate-900 dark:hover:text-white"
          >
            <FaLinkedin />
          </a>
          <a
            href="https://dev.to/arcanoix"
            target="_blank"
            rel="noreferrer"
            aria-label="DEV"
            class="transition-colors hover:text-slate-900 dark:hover:text-white"
          >
            <FaDev />
          </a>
          <a
            href="https://x.com/arcanoix_"
            target="_blank"
            rel="noreferrer"
            aria-label="X"
            class="transition-colors hover:text-slate-900 dark:hover:text-white"
          >
            <FaXTwitter />
          </a>
          <a
            href="https://wa.me/+584121367894"
            target="_blank"
            rel="noreferrer"
            aria-label="WhatsApp"
            class="transition-colors hover:text-slate-900 dark:hover:text-white"
          >
            <FaWhatsapp />
          </a>
        </div>

        <a
          href="https://www.freelancer.com/u/gustavoherrera84"
          target="_blank"
          rel="noreferrer"
          class="text-sm font-medium text-slate-600 hover:underline dark:text-slate-400"
        >
          freelancer.com/u/gustavoherrera84
        </a>
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-violet-500/10">
  <p
    class="mx-auto max-w-6xl px-4 py-6 text-center text-sm text-slate-500 dark:text-slate-400 sm:px-6"
  >
    {t("footer.made")} &#x2665; by Gustavo Herrera | @arcanoix
  </p>
</footer>
