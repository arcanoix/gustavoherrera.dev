---
import { useTranslations } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const services = ["assessment", "agents", "integrations", "monitoring"] as const
const assessmentSteps = ["map", "identify", "prioritize"] as const
const integrationSteps = ["order", "invoice", "record"] as const
const monitoringEvents = ["success", "retry", "alert"] as const
---

<section
  id="services"
  aria-labelledby="services-heading"
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28"
>
  <div
    class="mb-8 grid gap-5 md:mb-10 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:items-end md:gap-10"
  >
    <div>
      <p
        class="mb-3 flex items-center gap-2 text-sm font-semibold text-violet-700 dark:text-violet-300"
      >
        <span aria-hidden="true" class="h-px w-6 bg-violet-500"></span>
        {t("nav.services")}
      </p>
      <h2
        id="services-heading"
        class="max-w-2xl text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl lg:text-5xl"
      >
        {t("services.headline")}
      </h2>
    </div>
    <div>
      <p class="max-w-prose leading-relaxed text-slate-700 dark:text-slate-300">
        {t("services.intro")}
      </p>
      <a
        href="#contact"
        class="primary-action mt-4 inline-flex min-h-12 items-center gap-3 rounded-xl px-5 py-3 text-sm font-semibold focus-visible:outline-violet-500"
      >
        {t("services.contact")}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <ul role="list" class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
    {
      services.map((service, index) => (
        <li class="flex min-w-0 flex-col rounded-2xl border border-violet-200/80 bg-white/80 p-4 dark:border-violet-400/20 dark:bg-white/5 sm:p-6">
          <div class="mb-5">
            <div
              aria-hidden="true"
              class="mb-3 flex items-center gap-3 font-mono text-xs font-semibold text-violet-700 dark:text-violet-300"
            >
              {String(index + 1).padStart(2, "0")}
              <span class="h-px flex-1 bg-violet-200 dark:bg-violet-400/20" />
            </div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
              {t(`services.${service}.title`)}
            </h3>
            <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300">
              {t(`services.${service}.description`)}
            </p>
          </div>

          <figure
            data-service-example={service}
            class="mt-auto min-h-40 rounded-xl border border-violet-200/70 bg-violet-50/80 p-3 text-sm text-slate-800 dark:border-violet-400/15 dark:bg-slate-950/50 dark:text-slate-200 sm:p-4"
          >
            <figcaption class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">
              {t("services.example")}
            </figcaption>

            {service === "assessment" && (
              <ol class="grid gap-2">
                {assessmentSteps.map((step, index) => (
                  <li class="flex items-center gap-2.5">
                    <span
                      aria-hidden="true"
                      class="grid size-6 shrink-0 place-content-center rounded-full border border-violet-200 bg-white font-mono text-xs text-violet-700 dark:border-violet-400/25 dark:bg-violet-400/10 dark:text-violet-300"
                    >
                      {index + 1}
                    </span>
                    {t(`services.assessment.example.${step}`)}
                  </li>
                ))}
              </ol>
            )}

            {service === "agents" && (
              <div class="grid gap-2">
                <p class="w-fit max-w-full rounded-lg rounded-bl-none border border-violet-200/80 bg-white px-2.5 py-1.5 dark:border-white/10 dark:bg-white/5">
                  <strong>{t("services.agents.example.requester")}</strong>{" "}
                  {t("services.agents.example.request")}
                </p>
                <p class="w-fit max-w-full justify-self-end rounded-lg rounded-br-none bg-violet-100 px-2.5 py-1.5 dark:bg-violet-400/15">
                  <strong>{t("services.agents.example.agent")}</strong>{" "}
                  {t("services.agents.example.response")}
                </p>
                <p class="justify-self-end text-right text-xs font-semibold text-violet-700 dark:text-violet-300">
                  <span aria-hidden="true">↳ </span>
                  {t("services.agents.example.review")}
                </p>
              </div>
            )}

            {service === "integrations" && (
              <ol
                role="list"
                class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.82fr)]"
              >
                {integrationSteps.map((step, index) => (
                  <li class="flex min-w-0 items-stretch">
                    <div class="grid min-w-0 flex-1 grid-cols-1 content-center gap-1 rounded-lg border border-violet-200/80 bg-white px-1 py-2.5 text-center text-xs dark:border-white/10 dark:bg-white/5 sm:px-2">
                      <span
                        aria-hidden="true"
                        class="font-mono text-violet-700 dark:text-violet-300"
                      >
                        {index === 0 ? "01" : index === 1 ? "XML" : "03"}
                      </span>
                      <span class="break-words font-semibold">
                        {t(`services.integrations.example.${step}`)}
                      </span>
                    </div>
                    {index < integrationSteps.length - 1 && (
                      <span
                        aria-hidden="true"
                        class="w-4 shrink-0 self-center text-center text-xs text-violet-700 dark:text-violet-300 sm:w-5"
                      >
                        →
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            )}

            {service === "monitoring" && (
              <ul
                role="list"
                class="divide-y divide-violet-200/80 font-mono text-xs dark:divide-white/10"
              >
                {monitoringEvents.map((event) => (
                  <li class="flex items-center gap-2 py-2 first:pt-0 last:pb-0">
                    <span
                      aria-hidden="true"
                      class:list={[
                        "size-2 shrink-0 rounded-full",
                        event === "success" &&
                          "bg-emerald-600 dark:bg-emerald-400",
                        event === "retry" && "bg-amber-600 dark:bg-amber-400",
                        event === "alert" && "bg-violet-600 dark:bg-violet-400",
                      ]}
                    />
                    {t(`services.monitoring.example.${event}`)}
                  </li>
                ))}
              </ul>
            )}
          </figure>
        </li>
      ))
    }
  </ul>
</section>
