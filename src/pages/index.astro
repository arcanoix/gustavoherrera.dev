---
import ProjectSection from "@/components/ProjectSection"
import PostsSection from "@/components/PostsSection"
import Timeline from "@/components/Timeline"
import Avatar from "@/components/Avatar"
import SkillsSection from "@/components/SkillsSection"
import Layout from "@/layouts/Layout.astro"
import { HiOutlineArrowDownCircle as DownIcon } from "react-icons/hi2"
import { FaGithub, FaLinkedin, FaDev } from "react-icons/fa"
import { FaXTwitter } from "react-icons/fa6"
import "@/styles/globals.css"
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme")
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
  }
  const isDark = getThemePreference() === "dark"
  document.documentElement.classList[isDark ? "add" : "remove"]("dark")

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark")
      localStorage.setItem("theme", isDark ? "dark" : "light")
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })
  }
</script>

<Layout>
  <main class="p-4 text-slate-700 dark:text-slate-400">

    <!-- Hero -->
    <section class="flex flex-col w-full h-screen justify-center items-center gap-6">
      <div class="flex flex-col items-center gap-3 text-center max-w-2xl">
        <span class="text-xs font-semibold tracking-widest uppercase text-slate-500 dark:text-slate-400">
          Senior Fullstack Developer
        </span>
        <h1 class="text-4xl md:text-6xl font-bold text-slate-800 dark:text-slate-100">
          Gustavo Herrera
        </h1>
        <p class="text-base md:text-lg text-slate-500 dark:text-slate-400 max-w-xl">
          Building robust web applications and scalable APIs for over 15 years. Specialized in
          Laravel, React, and modern fullstack solutions &mdash; from business automation to SaaS platforms.
        </p>
        <p class="text-sm text-slate-400 dark:text-slate-500">Venezuela &middot; Remote</p>
      </div>

      <div class="flex gap-6 md:gap-10 mt-2 border border-slate-200 dark:border-slate-700 rounded-2xl px-6 md:px-10 py-4">
        <div class="text-center">
          <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">15+</p>
          <p class="text-xs text-slate-500">Years</p>
        </div>
        <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
        <div class="text-center">
          <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">333+</p>
          <p class="text-xs text-slate-500">Repos</p>
        </div>
        <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
        <div class="text-center">
          <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">5.0</p>
          <p class="text-xs text-slate-500">Rating</p>
        </div>
        <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
        <div class="text-center">
          <p class="text-2xl font-bold text-slate-800 dark:text-slate-200">28</p>
          <p class="text-xs text-slate-500">Reviews</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 justify-center mt-2">
        <a
          href="https://www.freelancer.com/u/gustavoherrera84"
          target="_blank"
          rel="noreferrer"
          class="px-5 py-2 rounded-full bg-slate-800 dark:bg-slate-200 text-slate-100 dark:text-slate-800 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Hire me
        </a>
        <a
          href="#projects"
          class="px-5 py-2 rounded-full border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          View Projects
        </a>
      </div>

      <DownIcon className="text-2xl animate-bounce mt-2" />
    </section>

    <!-- Projects -->
    <section id="projects" class="flex flex-col w-full justify-center items-center gap-28">
      <h2 class="font-bold">Projects</h2>
      <ProjectSection client:load />
    </section>

    <!-- Skills -->
