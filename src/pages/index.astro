        <div class="flex gap-6 text-2xl text-slate-700 dark:text-slate-300">
          <a href="https://github.com/arcanoix" target="_blank" rel="noreferrer" class="hover:scale-110 transition-transform">
            <FaGithub />
          </a>
          <a href="https://www.linkedin.com/in/thavoo/" target="_blank" rel="noreferrer" class="hover:scale-110 transition-transform">
            <FaLinkedin />
          </a>
          <a href="https://dev.to/arcanoix" target="_blank" rel="noreferrer" class="hover:scale-110 transition-transform">
            <FaDev />
          </a>
          <a href="https://x.com/arcanoix_" target="_blank" rel="noreferrer" class="hover:scale-110 transition-transform">
            <FaXTwitter />
          </a>
        </div>
        <a
          href="https://www.freelancer.com/u/gustavoherrera84"
          target="_blank"
          rel="noreferrer"
