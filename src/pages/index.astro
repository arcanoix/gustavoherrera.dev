      <h2 class="font-bold">Experience</h2>
      <Timeline />
    </section>

    <!-- Posts -->
    <section id="posts" class="flex flex-col w-full justify-center items-center gap-28 mt-56">
      <h2 class="font-bold">Posts</h2>
